---
// This top section is for JavaScript that runs when the site is built.
// The HTML below it is what visitors see.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Jacob Angell</title>
	</head>
	<body>
		<main>
			<p class="name">Jacob Angell</p>
			<h1>In the works<span class="dots"><span>.</span><span>.</span><span>.</span></span></h1>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
		background: #100f0f;
		color: #fffcf0;
		font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
	}
	main {
		text-align: center;
		padding: 1rem;
	}
	.name {
		margin: 0 0 0.5rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-size: 0.85rem;
		color: #878580;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 10vw, 5.5rem);
		font-weight: 700;
	}
	.dots span {
		animation: blink 1.4s infinite both;
		color: #da702c;
	}
	.dots span:nth-child(2) { animation-delay: 0.2s; }
	.dots span:nth-child(3) { animation-delay: 0.4s; }
	@keyframes blink {
		0%, 80%, 100% { opacity: 0.2; }
		40% { opacity: 1; }
	}
</style>
